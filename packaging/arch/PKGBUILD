# Maintainer: Jérôme Poulin <jeromepoulin@gmail.com>
#
# Builds the working tree, not a release tarball: this lives in the repo so
# `makepkg -si` installs what is checked out. Reachable as `make arch` from the
# repo root.
#
# Deliberately NOT in the repo root: makepkg's own build directory is $startdir/src,
# which there would sit on top of the crate's src/. Run it from here.
#
# The version comes from the same script the Makefile's .deb uses, assigned here
# rather than through a pkgver() function: makepkg rewrites this file in place
# when pkgver() disagrees with the assignment, which would dirty the checkout
# the version is read from.

_repo="${startdir}/../.."

pkgname=vault-rs
pkgver=$("$_repo/scripts/package-version.sh")
pkgrel=1
pkgdesc='PKI certificate management for HashiCorp Vault'
arch=('x86_64' 'aarch64')
url='https://github.com/ticpu/vault-rs'
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'cmake' 'git')
# tests/against_a_real_vault.rs drives the real binary and fails without it
# rather than skipping, so check() needs it present.
checkdepends=('vault')
# Optional rather than a dependency: the verbs an operator reaches for daily
# are answered over the API, and the binary is needed only for the ones this
# tool does not model.
optdepends=(
	'vault: forwarded subcommands (policy, operator, ssh, transit, ...) and the vault-rs vault escape hatch'
	'openssl: cert export --text and cert show --text'
)
# Cargo applies its own release profile; makepkg's LTO flags fight it, and a
# -debug split package out of a release build is noise nobody asked for.
options=('!lto' '!debug')

# Cargo.lock reaches the working tree on a release tag and nowhere else, so
# --locked applies to a tag build and would refuse to create the file on any
# other. fetch resolves and downloads; everything after it runs offline.
_locked=()
if [ -f "$_repo/Cargo.lock" ]; then
	_locked=(--locked)
fi

prepare() {
	cd "$_repo"
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch "${_locked[@]}" --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
	cd "$_repo"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR="$_repo/target"
	cargo build "${_locked[@]}" --offline --release
}

check() {
	cd "$_repo"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR="$_repo/target"
	cargo test "${_locked[@]}" --offline --release
}

package() {
	cd "$_repo"
	local bin="target/release/$pkgname"

	install -Dm755 "$bin" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"

	# Generated by the binary just built, so they cannot drift from its flags.
	install -dm755 "$pkgdir/usr/share/bash-completion/completions"
	install -dm755 "$pkgdir/usr/share/zsh/site-functions"
	install -dm755 "$pkgdir/usr/share/fish/vendor_completions.d"
	"$bin" completion bash > "$pkgdir/usr/share/bash-completion/completions/$pkgname"
	"$bin" completion zsh > "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
	"$bin" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
}
