# Maintainer: Jérôme Poulin <jeromepoulin@gmail.com>
#
# Builds the working tree, not a release tarball: this lives in the repo so
# `makepkg -si` installs what is checked out. pkgver comes from Cargo.toml,
# with the commit appended unless HEAD is a clean v* tag — the same rule the
# Makefile applies to the .deb, so a locally built package can never be
# mistaken for the released one.
#
# Deliberately NOT in the repo root: makepkg's own build directory is $startdir/src,
# which there would sit on top of the crate's src/. Run it from here.

_repo="${startdir}/../.."

pkgname=vault-rs
pkgver=0.1.0
pkgrel=1
pkgdesc='PKI certificate management for HashiCorp Vault'
arch=('x86_64' 'aarch64')
url='https://github.com/ticpu/vault-rs'
license=('GPL-3.0-only')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'cmake' 'git')
optdepends=(
	'vault: passthrough subcommands (read, write, kv, policy, ...)'
	'openssl: cert export --text and cert show --text'
)
# Cargo applies its own release profile; makepkg's LTO flags fight it.
options=('!lto')

pkgver() {
	cd "$_repo"
	local version commit
	version=$(grep '^version' Cargo.toml | head -1 | cut -d'"' -f2)
	if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
		commit=$(git rev-parse --short HEAD)
		echo "${version}+${commit}.dirty"
	elif [ -n "$(git tag --points-at HEAD --list 'v*')" ]; then
		echo "$version"
	else
		commit=$(git rev-parse --short HEAD)
		echo "${version}+${commit}"
	fi
}

build() {
	cd "$_repo"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR="$_repo/target"
	cargo build --frozen --release
}

check() {
	cd "$_repo"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR="$_repo/target"
	cargo test --frozen --release
}

package() {
	cd "$_repo"
	local bin="target/release/$pkgname"

	install -Dm755 "$bin" "$pkgdir/usr/bin/$pkgname"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"

	# Generated by the binary just built, so they cannot drift from its flags.
	install -dm755 "$pkgdir/usr/share/bash-completion/completions"
	install -dm755 "$pkgdir/usr/share/zsh/site-functions"
	install -dm755 "$pkgdir/usr/share/fish/vendor_completions.d"
	"$bin" completion bash > "$pkgdir/usr/share/bash-completion/completions/$pkgname"
	"$bin" completion zsh > "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
	"$bin" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
}
